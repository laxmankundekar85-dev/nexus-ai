# =============================================================================
# NEXUS AI — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Nexus AI"
APP_VERSION=1.0.0
DEBUG=true

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://nexus:nexuspassword@localhost:5432/nexus_ai
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://nexus:nexuspassword@localhost:5432/nexus_ai

POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexuspassword
POSTGRES_DB=nexus_ai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AI Provider ───────────────────────────────────────────────────────────────
# Provider: openai | anthropic | gemini | mock
LLM_PROVIDER=mock
# Your API key (leave blank to use mock mode)
LLM_API_KEY=
# Model name (e.g. gpt-4o, claude-3-5-sonnet-20241022, gemini-1.5-pro)
LLM_MODEL=gpt-4o
# Base URL override (for Azure OpenAI or compatible APIs)
LLM_BASE_URL=

# ── Search Provider ───────────────────────────────────────────────────────────
# Provider: tavily | serpapi | mock
SEARCH_PROVIDER=mock
SEARCH_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# Storage backend: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/uploads
# S3 settings (only if STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_EXECUTIONS_PER_HOUR=10

# ── Execution Limits ──────────────────────────────────────────────────────────
MAX_EXECUTION_DURATION_SECONDS=3600
MAX_AGENT_ITERATIONS=20
MAX_TOOL_CALLS_PER_EXECUTION=50
MAX_UPLOAD_SIZE_MB=50

# ── Embeddings ────────────────────────────────────────────────────────────────
# Set to true to enable pgvector semantic search
ENABLE_EMBEDDINGS=false
EMBEDDING_MODEL=text-embedding-3-small

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Never set to true in production
LOG_SQL_QUERIES=false
