{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexus-ai-backend-api.loca.lt/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|llms\\.txt|ai-catalog\\.json|favicon\\.svg|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ]
}